# Server-only. None of these are NEXT_PUBLIC_ — that is the point.
EMPORIX_TENANT=your-tenant
EMPORIX_STOREFRONT_CLIENT_ID=your-storefront-client-id

# The one public value: a tenant name is not a secret, and the catalog route
# validates it server-side anyway.
NEXT_PUBLIC_EMPORIX_TENANT=your-tenant
